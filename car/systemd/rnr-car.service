[Unit]
Description=RN Racing car LoRa telemetry TX
After=multi-user.target
Wants=multi-user.target

[Service]
Type=simple
User=rnracing
WorkingDirectory=/home/rnracing/rnracing/car
ExecStartPre=/bin/sleep 8
# Adjust serial paths / --freq for your hardware (prefer /dev/serial/by-id/...):
ExecStart=/usr/bin/python3 /home/rnracing/rnracing/car/transmit.py --freq 915 --lora-port /dev/ttyUSB0 --gps-port /dev/ttyUSB1 --obd-port /dev/ttyUSB2

Restart=always
RestartSec=5

Environment=PYTHONUNBUFFERED=1

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
