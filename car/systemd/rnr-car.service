[Unit]
Description=RN Racing car LoRa telemetry TX
After=multi-user.target bluetooth.service rnr-obd-bluetooth.service
Wants=multi-user.target rnr-obd-bluetooth.service

[Service]
Type=simple
User=rnracing
WorkingDirectory=/home/rnracing/rnracing/car
ExecStartPre=/bin/sleep 8
# Set LoRa/GPS from: python3 list_ports.py  (use /dev/serial/by-id/... paths)
ExecStart=/usr/bin/python3 /home/rnracing/rnracing/car/transmit.py --freq 915 \
  --lora-port /dev/serial/by-id/REPLACE_LORA \
  --gps-port /dev/serial/by-id/REPLACE_GPS \
  --obd-port /dev/obd

Restart=always
RestartSec=5

Environment=PYTHONUNBUFFERED=1

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
